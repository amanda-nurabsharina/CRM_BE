# APP
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# DATABASE
DB_DRIVER=sqlite
DB_NAME=crm.db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# JWT CONFIGURATION
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS
CORS_ORIGIN=*
